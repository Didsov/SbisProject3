{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SBIS: загрузить выборку",
            "type": "debugpy",
            "request": "launch",
            "module": "src.client_loader",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--selection",
                "${input:selectionId}"
            ]
        },
        {
            "name": "SBIS: выборка + 10 карточек",
            "type": "debugpy",
            "request": "launch",
            "module": "src.client_loader",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--selection",
                "${input:selectionId}",
                "--enrich-limit",
                "10"
            ]
        },
        {
            "name": "SBIS: выборка + все карточки",
            "type": "debugpy",
            "request": "launch",
            "module": "src.client_loader",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--selection",
                "${input:selectionId}",
                "--enrich-all"
            ]
        },

        {
            "name": "SQL: показать все запросы",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sql_export",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--list"
            ]
        },
        {
            "name": "SQL: экспорт по имени",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sql_export",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--query",
                "${input:sqlQueryName}"
            ]
        },

        {
            "name": "SQL ⭐ Все клиенты всех выборок",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sql_export",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--query",
                "all_full_clients"
            ]
        },
        {
            "name": "SQL ⭐ Все клиенты конкретной выборки",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sql_export",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--query",
                "selection_full_clients",
                "--param",
                "selection_id=${input:selectionId}"
            ]
        },
        {
            "name": "SQL ⭐ Сводка по выборкам",
            "type": "debugpy",
            "request": "launch",
            "module": "src.sql_export",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--query",
                "selections_summary"
            ]
        }
    ],
    "inputs": [
        {
            "id": "selectionId",
            "type": "promptString",
            "description": "Номер выборки СБИС",
            "default": "41307"
        },
        {
            "id": "sqlQueryName",
            "type": "promptString",
            "description": "Имя SQL-запроса без .sql",
            "default": "all_full_clients"
        }
    ]
}